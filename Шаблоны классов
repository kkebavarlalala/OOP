#include <iostream>
#include <string>
using namespace std;    

template <typename T1, typename T2>
class Pair
{
    T1 a;
    T2 b;
public:
    Pair()
    {
        a = T1();
        b = T2();
    }

    Pair(T1 first, T2 second)
    {
        a = first;
        b = second;
    }

	void show()
    {
		cout << "First: " << a << endl << "Second: " << b << endl;
	}
    
	T1 GetFirst()
    {
		return a;
	}
    T2 GetSecond()
    {
        return b;
    }
    void copyFrom(const Pair<T1, T2>& other)
    {
        a = other.a;
        b = other.b;
    }

    void clear()
    {
		a = T1();
		b = T2();
    }
};

int main()
{
    Pair<string, int> student("Petr", 20);
    Pair<string, double> product("Laptop", 19.9);
    Pair<int, double> groupInfo(101, 4.65);

    student.show();
    product.show();
    groupInfo.show();

    Pair<string, int> studentCopy;
    studentCopy.copyFrom(student);
    studentCopy.show();

    studentCopy.clear();
    studentCopy.show();

}
