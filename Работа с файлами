#include <iostream>
#include <fstream>
#include <string>

using namespace std;

int main()
{
    ofstream outFile("text.txt");

    if (!outFile.is_open())
    {
        cout << "Error: Could not open the file for writing!" << endl;
        return 1;
    }

    string inputLine;
    cout << "Enter a line of text: ";
    getline(cin, inputLine);

    outFile << inputLine << endl; 
    outFile.close(); 

    cout << "Text saved to text.txt" << endl << endl;

    ifstream inFile("text.txt");

    if (!inFile.is_open())
    {
        cout << "Error" << endl;
    }

    string line;
    int lineCount = 0;
    while (getline(inFile, line))
    {
        lineCount++;
    }

    inFile.clear();
    inFile.seekg(0);

    string word;
    int wordCount = 0;
    while (inFile >> word)
    {
        wordCount++;
    }

    inFile.close();

    cout << "Number of lines: " << lineCount << endl;
    cout << "Number of words: " << wordCount << endl;



}
